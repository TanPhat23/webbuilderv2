              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "animate",
            "preset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
