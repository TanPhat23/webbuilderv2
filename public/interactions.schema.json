        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            },
            "reset": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            },
            "wait": {
              "type": "number",
              "minimum": 0,
              "maximum": 60000
            }
          },
          "required": [
            "wait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            },
            "if": {
              "type": "string",
              "minLength": 1
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          },
          "required": [
            "if",
            "then"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
