    "interaction": {
      "type": "object",
      "properties": {
        "on": {
          "type": "string",
          "enum": [
            "click",
            "dblclick",
            "mousedown",
            "mouseup",
            "mouseenter",
            "mouseleave",
            "focus",
            "blur",
            "change",
            "input",
            "submit",
            "keydown",
            "keyup",
            "load",
            "error",
            "visible"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "preventDefault": {
          "type": "boolean"
        },
        "stopPropagation": {
          "type": "boolean"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "once": {
          "type": "boolean"
        },
        "do": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "required": [
        "on",
        "do"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "on": {
                "enum": [
                  "keydown",
                  "keyup"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "once"
            ]
          },
          "then": {
            "properties": {
              "on": {
                "const": "visible"
              }
            }
          }
        }
      ]
    }
  }
}
