{
  "name": "webbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/editor dev",
    "dev:editor": "bun run --cwd apps/editor dev",
    "dev:sites": "bun run --cwd apps/sites dev",
    "dev:all": "bun --filter '@webbuilder/editor' --filter '@webbuilder/sites' dev",
    "build": "bun run --cwd apps/editor build",
    "build:editor": "bun run --cwd apps/editor build",
    "build:sites": "bun run --cwd apps/sites build",
    "build:all": "bun run build:editor && bun run build:sites",
    "preview": "bun run --cwd apps/editor preview",
    "preview:sites": "bun run --cwd apps/sites preview",
    "start": "bun run --cwd apps/editor start",
    "start:editor": "bun run --cwd apps/editor start",
    "start:sites": "bun run --cwd apps/sites start",
    "typecheck": "tsc --noEmit && bun run --cwd packages/site-runtime typecheck && bun run --cwd apps/editor typecheck && bun run --cwd apps/sites typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:collab": "bash scripts/e2e-collab.sh",
    "test:style-controls": "node --import tsx --test tests/style-controls.browser.ts",
    "test:unit": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:integration": "bash scripts/it-realtime.sh",
    "interactions:schema": "node --import tsx scripts/interactions-schema.ts"
  },
  "devDependencies": {
    "@clerk/testing": "^2.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "dotenv": "^17.4.2",
    "lint-staged": "^14.0.1",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/types": "7.29.14",
    "dompurify": "3.4.18",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
