{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".output/**",
    "apps/*/.output/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "apps/*/src/routeTree.gen.ts"
  ],
  "rules": {
    "react/self-closing-comp": "error",
    "typescript/no-explicit-any": "warn"
  }
}
