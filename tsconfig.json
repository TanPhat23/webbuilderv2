{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./apps/editor/src/*"],
      "tests/*": ["./tests/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "apps/editor/src/**/*.ts",
    "apps/editor/src/**/*.tsx",
    "packages/site-runtime/src/**/*.ts",
    "packages/site-runtime/src/**/*.tsx"
  ],
  "exclude": ["node_modules", ".output", ".vinxi", "apps/sites"]
}
